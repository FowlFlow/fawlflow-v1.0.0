// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MaterialUnit {
  KG
  TON
}

model Farm {
  id        String   @id @default(cuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cages Cage[]
}

model Cage {
  id                  String    @id @default(cuid())
  farmId              String
  farm                Farm      @relation(fields: [farmId], references: [id])
  name                String
  currentChickenCount Int       @default(0)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  eggCollections EggCollection[]
  feedUsages     FeedUsage[]

  @@unique([farmId, name])
  @@index([farmId])
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  email      String?
  address    String?
  isSupplier Boolean  @default(false)
  isBuyer    Boolean  @default(false)
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rawMaterialPurchases RawMaterialPurchase[]
  feedSales            FeedSale[]
  rawMaterialSales     RawMaterialSale[]
  eggSales             EggSale[]

  @@index([isSupplier])
  @@index([isBuyer])
}

model RawMaterial {
  id                    String       @id @default(cuid())
  nameEn                String
  nameSi                String
  unit                  MaterialUnit @default(KG)
  defaultSellPricePerKg Decimal      @default(0) @db.Decimal(12, 2)
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  purchases    RawMaterialPurchase[]
  recipeItems  FeedRecipeItem[]
  consumptions FeedProductionConsumption[]
  sales        RawMaterialSale[]

  @@unique([nameEn])
  @@index([isActive])
}

model RawMaterialPurchase {
  id              String       @id @default(cuid())
  materialId      String
  material        RawMaterial  @relation(fields: [materialId], references: [id])
  supplierId      String
  supplier        Contact      @relation(fields: [supplierId], references: [id])
  date            DateTime     @db.Date
  enteredUnit     MaterialUnit
  enteredQuantity Decimal      @db.Decimal(12, 3)
  quantityKg      Decimal      @db.Decimal(12, 3)
  totalCost       Decimal      @db.Decimal(12, 2)
  unitCostPerKg   Decimal      @db.Decimal(12, 2)
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([materialId, date])
  @@index([supplierId])
  @@index([date])
}

model FeedType {
  id                    String   @id @default(cuid())
  nameEn                String
  nameSi                String
  batchSizeKg           Decimal  @db.Decimal(12, 3)
  defaultSellPricePerKg Decimal  @db.Decimal(12, 2)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  recipeItems FeedRecipeItem[]
  productions FeedProductionBatch[]
  sales       FeedSale[]
  usages      FeedUsage[]

  @@unique([nameEn])
  @@index([isActive])
}

model FeedRecipeItem {
  id                 String      @id @default(cuid())
  feedTypeId         String
  feedType           FeedType    @relation(fields: [feedTypeId], references: [id])
  materialId         String
  material           RawMaterial @relation(fields: [materialId], references: [id])
  quantityPerBatchKg Decimal     @db.Decimal(12, 3)
  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([feedTypeId])
  @@index([materialId])
}

model FeedProductionBatch {
  id                 String    @id @default(cuid())
  feedTypeId         String
  feedType           FeedType  @relation(fields: [feedTypeId], references: [id])
  date               DateTime  @db.Date
  scaleFactor        Decimal   @db.Decimal(8, 4)
  quantityProducedKg Decimal   @db.Decimal(12, 3)
  notes              String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  consumptions FeedProductionConsumption[]

  @@index([feedTypeId, date])
  @@index([date])
}

model FeedProductionConsumption {
  id            String              @id @default(cuid())
  productionId  String
  production    FeedProductionBatch @relation(fields: [productionId], references: [id])
  materialId    String
  material      RawMaterial         @relation(fields: [materialId], references: [id])
  date          DateTime            @db.Date
  quantityKg    Decimal             @db.Decimal(12, 3)
  unitCostPerKg Decimal             @db.Decimal(12, 2)
  createdAt     DateTime            @default(now())

  @@index([productionId])
  @@index([materialId, date])
  @@index([date])
}

model FeedSale {
  id          String    @id @default(cuid())
  feedTypeId  String
  feedType    FeedType  @relation(fields: [feedTypeId], references: [id])
  buyerId     String
  buyer       Contact   @relation(fields: [buyerId], references: [id])
  date        DateTime  @db.Date
  quantityKg  Decimal   @db.Decimal(12, 3)
  pricePerKg  Decimal   @db.Decimal(12, 2)
  totalAmount Decimal   @db.Decimal(12, 2)
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([feedTypeId, date])
  @@index([buyerId])
  @@index([date])
}

model FeedUsage {
  id         String    @id @default(cuid())
  feedTypeId String
  feedType   FeedType  @relation(fields: [feedTypeId], references: [id])
  cageId     String?
  cage       Cage?     @relation(fields: [cageId], references: [id])
  date       DateTime  @db.Date
  quantityKg Decimal   @db.Decimal(12, 3)
  notes      String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([feedTypeId, date])
  @@index([cageId])
  @@index([date])
}

model RawMaterialSale {
  id            String      @id @default(cuid())
  materialId    String
  material      RawMaterial @relation(fields: [materialId], references: [id])
  buyerId       String
  buyer         Contact     @relation(fields: [buyerId], references: [id])
  date          DateTime    @db.Date
  quantityKg    Decimal     @db.Decimal(12, 3)
  unitCostPerKg Decimal     @db.Decimal(12, 2)
  pricePerKg    Decimal     @db.Decimal(12, 2)
  totalAmount   Decimal     @db.Decimal(12, 2)
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([materialId, date])
  @@index([buyerId])
  @@index([date])
}

model EggTurn {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eggCollections EggCollection[]

  @@unique([name])
}

model EggCollection {
  id           String    @id @default(cuid())
  cageId       String
  cage         Cage      @relation(fields: [cageId], references: [id])
  turnId       String
  turn         EggTurn   @relation(fields: [turnId], references: [id])
  date         DateTime  @db.Date
  eggCount     Int
  crackedCount Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cageId, date])
  @@index([turnId])
  @@index([date])
}

model EggBoxType {
  id         String   @id @default(cuid())
  name       String
  eggsPerBox Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  eggSales EggSale[]

  @@unique([name])
}

model EggPrice {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  pricePerEgg Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
}

model EggSale {
  id               String      @id @default(cuid())
  buyerId          String
  buyer            Contact     @relation(fields: [buyerId], references: [id])
  date             DateTime    @db.Date
  boxTypeId        String?
  boxType          EggBoxType? @relation(fields: [boxTypeId], references: [id])
  boxCount         Int         @default(0)
  eggsPerBoxAtSale Int?
  looseEggCount    Int         @default(0)
  totalEggCount    Int
  ratePerEgg       Decimal     @db.Decimal(12, 2)
  totalAmount      Decimal     @db.Decimal(12, 2)
  notes            String?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([buyerId])
  @@index([boxTypeId])
  @@index([date])
}

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  passwordHash     String
  recoveryCodeHash String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
